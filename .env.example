# Public site origin, no trailing slash. Used for canonical URLs, OG tags and the sitemap.
NEXT_PUBLIC_SITE_URL=

# Neon POOLED connection string (the host containing "-pooler"). Server-only.
# Never prefix this with NEXT_PUBLIC_.
DATABASE_URL=

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Where application alerts and the waitlist digest are sent.
NOTIFY_EMAIL=

# Verified Resend sender, e.g. "Name <hello@yourdomain.com>".
# Production currently holds "Tora House <onboarding@resend.dev>", which is Resend's
# shared test sender: it needs no domain, and it will only deliver to the address that
# owns the Resend account. Replace it the moment a real domain is verified.
FROM_EMAIL=

# Long random string. Bearer token for /api/export and the waitlist digest cron.
EXPORT_TOKEN=
